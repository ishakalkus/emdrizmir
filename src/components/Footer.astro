---
import Logo from './Logo.astro';
import { CONTACT } from '../i18n/config.js';

interface Props { t: any; }
const { t } = Astro.props;
const f = t.footer;

/**
 * Mevzuatın internet sitesinde istediği kurum bilgileri.
 * Yalnızca config'te doldurulmuş alanlar yayınlanır; hiçbiri dolu
 * değilse blok hiç basılmaz (eksikler derleme sonunda bildirilir).
 */
const L = CONTACT.legal;
const legalRows = [
  [f.legal.officialName, L.officialName],
  [f.legal.facilityType, L.facilityType],
  [f.legal.licence, [L.licenceNo, L.licenceDate].filter(Boolean).join(' · ')],
  [f.legal.licenceAuthority, L.licenceAuthority],
  [f.legal.responsibleManager, L.responsibleManager],
].filter(([, value]) => value);
---
<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div class="foot__brand">
        <Logo label="EMDR İzmir" />
        <p>{f.about}</p>
      </div>

      <nav aria-label={t.a11y.footerNav}>
        <h2 class="foot__h">{f.pagesTitle}</h2>
        <ul>
          {f.pages.map((p: any) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="foot__h">{f.contactTitle}</h2>
        <ul>
          <li><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></li>
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a href={CONTACT.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={CONTACT.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={CONTACT.youtube} target="_blank" rel="noopener">YouTube</a></li>
        </ul>
      </div>
    </div>

    {legalRows.length > 0 && (
      <dl class="legal">
        <div class="legal__head">{f.legal.title}</div>
        {legalRows.map(([label, value]) => (
          <div class="legal__row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="crisis" set:html={f.crisisHtml} />

    <div class="foot__base">
      <span>© <span id="yr">{new Date().getFullYear()}</span> {f.rights}</span>
      <span>{f.kvkk}</span>
    </div>
  </div>
</footer>

{/* Landmark dışında kalmasın diye aside içinde; mobilde yazı gizlendiği
    için erişilebilir ad bağlantının kendisinde durmalı. */}
<aside>
  <a class="fab" href={CONTACT.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.6 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.6-3.1-1.3-5.1-4.4-5.3-4.6-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l1 2.3c.1.2.1.4 0 .6l-.4.5-.3.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.3.1.4.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2.2 1c.3.1.5.2.5.4.1.1.1.7-.1 1.4Z"/></svg>
    <span>WhatsApp</span>
  </a>
</aside>
