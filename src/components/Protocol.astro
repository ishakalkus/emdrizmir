---
interface Props { t: any; }
const { t } = Astro.props;
const p = t.protocol;
---
<section class="sect" id="protokol">
  <div class="wrap">
    <div class="sect__head">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2>{p.h2}</h2>
      <p>{p.intro}</p>
    </div>

    <ol class="phases">
      {p.phases.map((phase: any) => (
        <li class="phase">
          <span class="phase__n" aria-hidden="true"></span>
          <h3>{phase.title}{phase.en && <span>{phase.en}</span>}</h3>
          <p>{phase.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
