# Cloudflare Pages başlık kuralları.
# İki satır derleme sonrası (scripts/postbuild.mjs) doldurulur:
#  - Content-Security-Policy: satır içi betiklerin sha256 özetleriyle,
#    böylece politikada 'unsafe-inline' açmak gerekmez.
#  - X-Robots-Tag: *.pages.dev gibi geçici adreslerde noindex olur.

/*
  Content-Security-Policy: __CSP__
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: __XROBOTS__

# Parmak izli varlıklar: içerik değişince ad değişir, süresiz önbelleğe alınabilir
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Yazı tipleri sürüm boyunca sabit
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# Paylaşım görselini sosyal medya tarayıcıları çapraz kaynak olarak çeker
/og/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Resource-Policy: cross-origin

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800

# HTML her zaman doğrulansın ki yeni yayın anında görünsün
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
